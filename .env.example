# Required application configuration. These values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Auth Admin and invitation RPC access. Never use a NEXT_PUBLIC_ prefix.
# Never commit a populated secret key. Required for admin invitations and activation.
SUPABASE_SERVICE_ROLE_KEY=

# Optional E2E database verification.
# SUPABASE_URL=

# Optional E2E account overrides. Defaults are defined in the test helpers.
# E2E_TEST_TECH_EMAIL=
# E2E_TEST_TECH_PASSWORD=
# E2E_TEST_ADMIN_EMAIL=
# E2E_TEST_ADMIN_PASSWORD=
# E2E_TEST_VOLUNTEER_EMAIL=
# E2E_TEST_VOLUNTEER_PASSWORD=
# E2E_TEST_VIEWER_EMAIL=
# E2E_TEST_VIEWER_PASSWORD=